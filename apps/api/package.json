{
  "name": "@travada-books/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "tunnel": "cloudflared tunnel run --url http://localhost:8787 travada-dev",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:pull": "node scripts/db-pull.mjs",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.5",
    "@hono/node-server": "^2.1.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.0",
    "@travada-books/core": "*",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "postgres": "^4.1.1",
    "posthog-node": "^5.68.2",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "exports": {
    "./client": {
      "types": "./types/app.d.ts"
    }
  }
}
