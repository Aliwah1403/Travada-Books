# Copy to .env for local dev. On Render these are set per service.

# Supabase. Local dev: `supabase status -o env` (API_URL, SERVICE_ROLE_KEY).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis, TLS URL: rediss://default:<password>@<endpoint>:6379
REDIS_URL=

PORT=8787
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Without a key, analytics and error capture are off.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
